def _restart_units_text():
    path_unit = """[Unit]
Description=Watch %s and restart https-ssh on change

[Path]
PathChanged=%s
Unit=https-ssh-restart.service

[Install]
WantedBy=multi-user.target
""" % (DEFAULTS_FILE, DEFAULTS_FILE)
    service_unit = """[Unit]
Description=Restart https-ssh after its configuration changes

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl restart https-ssh.service
"""
    return path_unit, service_unit


def _read_defaults():
    """The HTTPS_SSH_* values already present in /etc/default/https-ssh."""
    wanted = ("HTTPS_SSH_HOST", "HTTPS_SSH_PORT", "HTTPS_SSH_SSH_PORT",
              "HTTPS_SSH_SECRET", "HTTPS_SSH_LOG",
              "HTTPS_SSH_TTL", "HTTPS_SSH_IDLE", "HTTPS_SSH_LOG_MAX")
    got = {}
    try:
        with open(DEFAULTS_FILE) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                if key in wanted:
                    got[key] = value
    except OSError:
        pass
    return got


def _effective_config(args):
    """Settings for the service: command line flags win, then the values
    already in /etc/default/https-ssh, then the current defaults."""
    existing = _read_defaults()
    explicit = getattr(args, "_explicit", set())

    def pick(key, attr, fallback, cast=None):
        if key in existing and attr not in explicit:
            raw = existing[key]
            if raw == "":
                return fallback
            if cast:
                try:
                    return cast(raw)
                except ValueError:
                    return fallback
            return raw
        return getattr(args, attr, fallback)

    return {
        "host": pick("HTTPS_SSH_HOST", "host", "127.0.0.1"),
        "port": pick("HTTPS_SSH_PORT", "port", DEFAULT_PORT, int),
        "ssh_port": pick("HTTPS_SSH_SSH_PORT", "ssh_port", DEFAULT_SSH_PORT, int),
        "secret": pick("HTTPS_SSH_SECRET", "secret", "") or "",
        "log": pick("HTTPS_SSH_LOG", "log", None),
        "ttl": pick("HTTPS_SSH_TTL", "ttl", TOKEN_TTL, int),
        "idle": pick("HTTPS_SSH_IDLE", "idle", IDLE_TIMEOUT, int),
        "log_max": pick("HTTPS_SSH_LOG_MAX", "log_max", LOG_MAX, int),
    }


def _defaults_text(cfg):
    log_line = ("HTTPS_SSH_LOG=%s" % cfg["log"]) if cfg["log"] \
        else "# HTTPS_SSH_LOG=/var/log/https-ssh.json"
    return """# /etc/default/https-ssh
#
# Configuration for the https-ssh systemd service. Change anything below and
# save the file: a watcher unit restarts the service automatically.

# local HTTP port the gateway listens on, published by cloudflared
HTTPS_SSH_HOST=%s
HTTPS_SSH_PORT=%d

# where sshd is running on this machine
