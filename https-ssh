_LOG_LOCK = threading.Lock()


def set_log_file(path):
    global LOG_FILE
    if path:
        LOG_FILE = os.path.abspath(os.path.expanduser(path))


def record_login(ok, user, host, port, method=None, reason=None, remote=None, client=None):
    """Append one login attempt to log.json (a JSON array, newest last)."""
    entry = {
        "time": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "epoch": int(time.time()),
        "event": "login",
        "ok": bool(ok),
        "user": user,
        "host": host,
        "port": port,
        "method": method,
        "remote": remote,
        "client": client or None,
    }
    if reason:
        entry["reason"] = reason
    with _LOG_LOCK:
        try:
            with open(LOG_FILE) as f:
                data = json.load(f)
            if not isinstance(data, list):
                data = []
        except (OSError, ValueError):
            data = []
        data.append(entry)
        if len(data) > LOG_MAX:
            data = data[-LOG_MAX:]
        tmp = LOG_FILE + ".tmp"
        try:
            with open(tmp, "w") as f:
                json.dump(data, f, indent=2)
                f.write("\n")
            os.chmod(tmp, 0o600)
            os.replace(tmp, LOG_FILE)
        except OSError as exc:
            log("WARNING: cannot write login log %s: %s" % (LOG_FILE, exc))


def env_int(name, fallback):
    try:
        return int(os.environ[name])
    except (KeyError, ValueError):
        return fallback


def prompt_password(user, host):
    """Ask for a password. Piped stdin is accepted, and a missing terminal
    produces a clean error instead of a traceback."""
    if not sys.stdin.isatty():
        line = sys.stdin.readline()
        if not line:
            raise SystemExit("no password given; use -p/--password or run from a terminal")
        return line.rstrip("\r\n")
    try:
        return getpass.getpass("SSH password for %s@%s: " % (user, host))
    except (EOFError, KeyboardInterrupt):
        raise SystemExit("no password given; use -p/--password or run from a terminal")


def split_target(spec, default_port=22):
    """Accept user@host, user@host:port, host (user defaults to $USER)."""
    if "@" in spec:
        user, rest = spec.split("@", 1)
    else:
        user, rest = os.environ.get("USER", "root"), spec
    rest = rest.strip("/")
    if ":" in rest and not rest.startswith("["):
        host, _, p = rest.rpartition(":")
        if p.isdigit():
            return user, host, int(p)
    return user, rest, default_port


# --------------------------------------------------------------------------- #
# credential verification - delegated to the real ssh binary
# --------------------------------------------------------------------------- #
_ASKPASS_DIR = None


def askpass_helper():
    """A tiny script that prints the password from the environment (never on disk)."""
    global _ASKPASS_DIR
    if _ASKPASS_DIR is None:
        _ASKPASS_DIR = tempfile.mkdtemp(prefix="https-ssh-")
        os.chmod(_ASKPASS_DIR, 0o700)
        path = os.path.join(_ASKPASS_DIR, "askpass.sh")
        with open(path, "w") as f:
            f.write("#!/bin/sh\nprintf '%s\\n' \"$HTTPS_SSH_PW\"\n")
        os.chmod(path, 0o700)
        _ASKPASS_DIR = (path,)
    return _ASKPASS_DIR[0]


def materialize_key(key):
    """`key` is either a path on this host or the literal key material.

    Returns (path, is_temp). Clients (e.g. https-ssh-client.sh) may send the
    private key text itself, which is written to a 0600 temp file and removed
    as soon as the check is done.
    """
    if "\n" in key or "PRIVATE KEY" in key:
        fd, path = tempfile.mkstemp(prefix="https-ssh-key-", suffix=".pem")
        try:
            os.write(fd, key.encode())
        finally:
            os.close(fd)
        os.chmod(path, 0o600)
        return path, True
    return os.path.expanduser(key), False


def verify_ssh(host, port, user, password=None, key=None, timeout=LOGIN_TIMEOUT):
    """Return (ok, method, detail). Runs the real ssh, so sshd is the judge."""
    ssh = shutil.which("ssh")
    if not ssh:
        return False, "unavailable", "the 'ssh' binary was not found on this host"

    temp_key = None

    base = [
        ssh,
        "-o", "StrictHostKeyChecking=accept-new",
        "-o", "UserKnownHostsFile=" + KNOWN_HOSTS,
        "-o", "LogLevel=ERROR",
        "-o", "NumberOfPasswordPrompts=1",
        "-o", "ConnectTimeout=%d" % min(timeout, 15),
        "-o", "RequestTTY=no",
        "-p", str(port),
    ]

    env = dict(os.environ)
    if password is not None:
        helper = askpass_helper()
        base += [
            "-o", "PreferredAuthentications=password,keyboard-interactive",
            "-o", "PubkeyAuthentication=no",
            "-o", "BatchMode=no",
        ]
        env["SSH_ASKPASS"] = helper
        env["SSH_ASKPASS_REQUIRE"] = "force"
        env["DISPLAY"] = env.get("DISPLAY", ":0")   # old-ssh fallback
        env["HTTPS_SSH_PW"] = password
        method = "password"
        if shutil.which("setsid"):
            base = ["setsid", "-w"] + base
    elif key:
        key_path, is_temp = materialize_key(key)
        if is_temp:
            temp_key = key_path
        base += [
            "-o", "PreferredAuthentications=publickey",
            "-o", "IdentitiesOnly=yes",
            "-o", "BatchMode=yes",
            "-i", key_path,
        ]
        method = "publickey"
    else:
        return False, "none", "no password or key supplied"

    cmd = base + ["%s@%s" % (user, host), "true"]
    try:
        try:
            proc = subprocess.run(
                cmd, env=env, timeout=timeout,
                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
            )
        except subprocess.TimeoutExpired:
            return False, method, "ssh to %s:%d timed out after %ds" % (host, port, timeout)
        except OSError as exc:
            return False, method, "could not run ssh: %s" % exc
    finally:
        if temp_key:
            try:
                os.unlink(temp_key)
            except OSError:
                pass

    err = proc.stderr.decode("utf-8", "replace").strip()
    if proc.returncode == 0:
        return True, method, "sshd accepted the credentials"
    if "Permission denied" in err or "Authentication failed" in err:
        return False, method, "sshd rejected the credentials (permission denied)"
    if "Connection refused" in err:
        return False, method, "connection refused by %s:%d" % (host, port)
    if "Connection timed out" in err or "Connection closed" in err:
        return False, method, "could not reach %s:%d" % (host, port)
    return False, method, err.splitlines()[-1] if err else "ssh exited with %d" % proc.returncode


# --------------------------------------------------------------------------- #
# token store
# --------------------------------------------------------------------------- #
class TokenStore:
    def __init__(self):
        self._tokens = {}
        self._failures = {}

    def create(self, user, host, port, method, credential=None):
        token = secrets.token_urlsafe(32)
        self._tokens[token] = {
            "user": user, "host": host, "port": port,
            "method": method, "created": time.time(),
            "expires": time.time() + TOKEN_TTL,
            # kept in memory only, so /exec can reuse the verified identity.
            # never written to disk, never logged, never returned by the API.
            "credential": credential or {},
        }
        return token

    def public_sessions(self):
        now = time.time()
        return [
            {"user": r["user"], "host": r["host"], "port": r["port"],
             "method": r["method"], "expires_in": int(r["expires"] - now)}
            for r in self._tokens.values() if r["expires"] > now
        ]

    def get(self, token):
        rec = self._tokens.get(token)
        if not rec:
            return None
        if rec["expires"] < time.time():
            self._tokens.pop(token, None)
            return None
        return rec

    def drop_user(self, user, host, port):
        gone = 0
        for tok, rec in list(self._tokens.items()):
            if (rec["user"], rec["host"], rec["port"]) == (user, host, port):
                self._tokens.pop(tok, None)
                gone += 1
        return gone

    def revoke(self, token):
        return self._tokens.pop(token, None) is not None if token else False

    # gentle brute-force brake in front of the real sshd
    def throttle(self, ip):
        rec = self._failures.get(ip)
        if not rec:
            return 0
        return max(0, rec["until"] - time.time())

    def record_failure(self, ip):
        rec = self._failures.setdefault(ip, {"count": 0, "until": 0})
        rec["count"] += 1
        if rec["count"] >= 3:
            rec["until"] = time.time() + min(30 * (rec["count"] - 2), 300)

    def record_success(self, ip):
        self._failures.pop(ip, None)


TOKENS = TokenStore()


# --------------------------------------------------------------------------- #
# WebSocket transport (RFC 6455, minimal: binary frames, no extensions)
#
# Why websockets and not a plain HTTP/1.1 "Upgrade: raw-tunnel"? Because
# Cloudflare's proxy answers 400 to requests that carry an unknown Upgrade
# header, and normalises a 101 from the origin. Websocket upgrades are the one
# streaming transport Cloudflare Tunnel fully supports, so that is what we use.
# --------------------------------------------------------------------------- #
WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"


def ws_accept(key):
    return base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()


class WebSocket:
    """Just enough of RFC 6455 to move a byte stream. Payloads are not masked
    unless mask=True (clients mask, servers do not)."""

    def __init__(self, sock, mask=False, initial=b""):
        self.sock = sock
        self.mask = mask
        self.buf = bytearray(initial)
        self.lock = threading.Lock()

    # ---- low level ---- #
    def _read_exact(self, n):
        while len(self.buf) < n:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("websocket closed")
            self.buf += chunk
        out = bytes(self.buf[:n])
        del self.buf[:n]
        return out

    def send_frame(self, opcode, payload=b""):
        b1 = 0x80 | opcode              # FIN set, no fragmentation on send
        length = len(payload)
        if length < 126:
            header = struct.pack("!BB", b1, length | (0x80 if self.mask else 0))
        elif length < 65536:
            header = struct.pack("!BBH", b1, 126 | (0x80 if self.mask else 0), length)
        else:
            header = struct.pack("!BBQ", b1, 127 | (0x80 if self.mask else 0), length)
        if self.mask:
            key = os.urandom(4)
            header += key
            payload = bytes(payload[i] ^ key[i % 4] for i in range(length))
        with self.lock:
            self.sock.sendall(header + payload)

    def recv_message(self):
        """Return (opcode, payload); (None, None) once the peer closes."""
        data = b""
        first_op = None
        while True:
            b1, b2 = self._read_exact(2)
            fin = b1 & 0x80
            opcode = b1 & 0x0F
            masked = b2 & 0x80
            length = b2 & 0x7F
            if length == 126:
                length = struct.unpack("!H", self._read_exact(2))[0]
            elif length == 127:
                length = struct.unpack("!Q", self._read_exact(8))[0]
            key = self._read_exact(4) if masked else None
            payload = self._read_exact(length) if length else b""
            if key:
                payload = bytes(payload[i] ^ key[i % 4] for i in range(len(payload)))

            if opcode == 0x8:                       # close
                return None, None
            if opcode == 0x9:                       # ping -> pong
                self.send_frame(0xA, payload)
                continue
            if opcode == 0xA:                       # pong
                continue

            if opcode in (0x1, 0x2):                # text/binary
                first_op = opcode
                data = payload
            elif opcode == 0x0:                     # continuation
                data += payload
            if fin:
                return first_op, data


def ws_bridge(ws, upstream, idle):
    """Pump bytes between a websocket and a raw TCP socket until either ends."""
    def ws_to_up():
        try:
            while True:
                op, data = ws.recv_message()
                if op is None:
                    break
                if data:
                    upstream.sendall(data)
        except (OSError, ConnectionError):
            pass
        finally:
            try:
                upstream.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            try:
                upstream.close()
            except OSError:
                pass

    def up_to_ws():
        try:
            while True:
                data = upstream.recv(65536)
                if not data:
                    break
                ws.send_frame(0x2, data)
        except (OSError, ConnectionError):
            pass
        finally:
            try:
                ws.send_frame(0x8)          # clean websocket close
            except Exception:
                pass
            try:
                ws.sock.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass

    ws.sock.settimeout(idle)
    a = threading.Thread(target=ws_to_up, daemon=True)
    b = threading.Thread(target=up_to_ws, daemon=True)
    a.start()
    b.start()
    a.join()
    b.join()


def ws_client_bridge(ws, in_fd, out_fd, idle):
    """Client side: pump stdin/stdout to and from the websocket."""
    done = threading.Event()

    def stdin_to_ws():
        try:
            while not done.is_set():
                data = os.read(in_fd, 65536)
                if not data:
                    break
                ws.send_frame(0x2, data)
        except (OSError, ConnectionError):
            pass

    def ws_to_stdout():
        try:
            while True:
                op, data = ws.recv_message()
                if op is None:
                    break
                if data:
                    os.write(out_fd, data)
        except (OSError, ConnectionError):
            pass
        finally:
            done.set()

    def keepalive():
        # Cloudflare drops idle websockets after ~100s; keep it warm
        while not done.wait(30):
            try:
                ws.send_frame(0x9, b"")
            except Exception:
                break

    ws.sock.settimeout(idle)
    ta = threading.Thread(target=stdin_to_ws, daemon=True)
    tb = threading.Thread(target=ws_to_stdout, daemon=True)
    tc = threading.Thread(target=keepalive, daemon=True)
    ta.start()
    tb.start()
    tc.start()
    tb.join()       # remote end closed -> the proxy is finished
    done.set()


# --------------------------------------------------------------------------- #
# HTTP gateway
# --------------------------------------------------------------------------- #
class Gateway(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "https-ssh/" + VERSION
    sys_version = ""
    # Unbuffered reads: the request headers are read byte-by-byte, so nothing
    # can be silently buffered past "\r\n\r\n". That matters because /tunnel
    # switches to a raw websocket on the very same socket.
    rbufsize = 0
    wbufsize = 0

    # silence the noisy default logging, keep it on stderr with a timestamp
    def log_message(self, fmt, *args):
        log("%s - %s" % (self._client_ip(), fmt % args))

    # Never echo raw request bytes: a header/body desync could otherwise write a
    # password straight into the log file.
    def log_request(self, code="-", size="-"):
        try:
            parts = (self.requestline or "").split(" ")
            method, target = (parts[0], parts[1]) if len(parts) >= 2 else ("?", "")
            if not target.startswith("/"):
                method, target = "MALFORMED", "<not echoed>"
            self.log_message('"%s %s" %s', method, target, code)
        except Exception:
            pass

    def log_error(self, fmt, *args):
        msg = fmt % args if args else fmt
        if "Bad request" in msg or "Bad HTTP" in msg or "Bad status" in msg:
            self.log_message("bad request from %s (details suppressed)", self._client_ip())
            return
        self.log_message("%s", msg)

    # ---------------- plumbing ---------------- #
    def _json(self, code, payload):
        body = json.dumps(payload, indent=2).encode() + b"\n"
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _read_body(self):
        """Always consume Content-Length, even when we are about to reject the
        request - an unread body desynchronises keep-alive connections."""
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = 0
        if length <= 0:
            return b""
        if length > 1024 * 1024:
            remaining = length
            while remaining > 0:
                chunk = self.rfile.read(min(65536, remaining))
                if not chunk:
                    break
                remaining -= len(chunk)
            return b""
        return self.rfile.read(length)

    def _body(self):
        raw = getattr(self, "_raw", b"")
        if not raw:
            return {}
        try:
            return json.loads(raw.decode("utf-8", "replace"))
        except ValueError:
            return None

    def _token(self):
        auth = self.headers.get("Authorization", "")
        if auth.lower().startswith("bearer "):
            return auth[7:].strip()
        return (self.headers.get("X-Auth-Token") or "").strip() or None

    def _local(self):
        return self.client_address[0] in ("127.0.0.1", "::1", "localhost")

    def _client_ip(self):
        """The real client address, even when the request arrives via a tunnel.

        Through cloudflared every connection comes from loopback, so the actual
        address is carried in CF-Connecting-IP (Cloudflare) and the proxy chain
        in X-Forwarded-For. Those headers are only honoured when the TCP peer is
        loopback (i.e. a local tunnel/agent), so a client that reaches the
        gateway directly cannot spoof its own address.
        """
        peer = self.client_address[0]
        if peer not in ("127.0.0.1", "::1", "localhost"):
            return peer
        for header in ("CF-Connecting-IP", "True-Client-IP", "X-Real-IP"):
            value = (self.headers.get(header) or "").strip()
            if value:
                return value
        forwarded = (self.headers.get("X-Forwarded-For") or "").strip()
        if forwarded:
            first = forwarded.split(",")[0].strip()
            if first:
                return first
        return peer

    def _basic_credentials(self):
        """(user, password) from an `Authorization: Basic` header, or None."""
        auth = self.headers.get("Authorization", "")
        if not auth.lower().startswith("basic "):
            return None
        try:
            raw = base64.b64decode(auth[6:].strip()).decode("utf-8", "replace")
        except Exception:
            return None
        if ":" not in raw:
            return None
        user, _, password = raw.partition(":")
        return user, password

    # ---------------- routes ---------------- #
    def do_GET(self):
        path = urlparse(self.path).path
        if path in ("/", "/info"):
            return self._info()
        if path == "/health":
            return self._json(200, {
                "ok": True,
                "service": "https-ssh",
                "version": VERSION,
                "ssh_host": "127.0.0.1",
                "ssh_port": self.server.default_ssh_port,
            })
        if path == "/tunnel":
            return self._tunnel()
        if path == "/sessions":
            if not self._local() and not self.server.gateway_secret:
                return self._json(403, {"ok": False, "error": "forbidden"})
            return self._json(200, {"ok": True, "sessions": TOKENS.public_sessions()})
        return self._json(404, {"ok": False, "error": "not found", "path": path})

    def do_POST(self):
        self._raw = self._read_body()
        path = urlparse(self.path).path
        if path == "/login":
            return self._login()
        if path == "/exec":
            return self._exec()
        if path == "/logout":
            return self._logout()
        if path == "/tunnel":
            return self._tunnel()
        return self._json(404, {"ok": False, "error": "not found", "path": path})

    def _info(self):
        self._json(200, {
            "ok": True,
            "service": "https-ssh",
            "version": VERSION,
            "usage": {
                "login": "POST /login {host, port, user, password|key} -> {token}",
                "tunnel": "GET /tunnel  websocket; auth via Bearer token, ?token=, "
                          "or Authorization: Basic <user:password>",
                "exec": "POST /exec {token, command:[...]} -> {exit_code, stdout, stderr}",
                "health": "GET /health",
            },
        })

    def _login(self):
        ip = self._client_ip()
        agent = self.headers.get("User-Agent")
        wait = TOKENS.throttle(ip)
        if wait > 0:
            record_login(False, None, None, None, reason="throttled", remote=ip, client=agent)
            return self._json(429, {"ok": False, "error": "too many failures, retry in %.0fs" % wait})

        if self.server.gateway_secret:
            given = self.headers.get("X-Gateway-Secret", "")
            if not secrets.compare_digest(given, self.server.gateway_secret):
                record_login(False, None, None, None, reason="bad gateway secret",
                             remote=ip, client=agent)
                return self._json(401, {"ok": False, "error": "bad or missing X-Gateway-Secret"})

        payload = self._body()
        if payload is None:
            record_login(False, None, None, None, reason="invalid JSON", remote=ip, client=agent)
            return self._json(400, {"ok": False, "error": "body is not valid JSON"})

        host = str(payload.get("host") or "").strip()
        user = str(payload.get("user") or "").strip()
        password = payload.get("password")
        key = payload.get("key")
        try:
            # fall back to the port given with `https-ssh --ssh <port>`
            port = int(payload.get("port") or self.server.default_ssh_port)
        except (TypeError, ValueError):
            record_login(False, user or None, host or None, None,
                         reason="bad port", remote=ip, client=agent)
            return self._json(400, {"ok": False, "error": "port must be a number"})

        if not host or not user:
            record_login(False, user or None, host or None, port,
                         reason="host and user are required", remote=ip, client=agent)
            return self._json(400, {"ok": False, "error": "host and user are required"})
        if password is None and not key:
            record_login(False, user, host, port, reason="no credentials supplied",
                         remote=ip, client=agent)
            return self._json(400, {"ok": False, "error": "password or key is required"})

        ok, method, detail = verify_ssh(host, port, user, password, key)
        if not ok:
            TOKENS.record_failure(ip)
            record_login(False, user, host, port, method=method, reason=detail,
                         remote=ip, client=agent)
            log("LOGIN FAIL %s@%s:%d via %s - %s" % (user, host, port, method, detail))
            return self._json(401, {"ok": False, "error": detail, "method": method})

        TOKENS.record_success(ip)
        token = TOKENS.create(user, host, port, method,
                              credential={"password": password, "key": key})
        record_login(True, user, host, port, method=method, remote=ip, client=agent)
        log("LOGIN OK   %s@%s:%d via %s" % (user, host, port, method))
        return self._json(200, {
            "ok": True, "token": token, "method": method,
            "target": {"user": user, "host": host, "port": port},
            "expires_in": TOKEN_TTL,
        })

    def _logout(self):
        payload = self._body() or {}
        token = payload.get("token") or self._token()
        return self._json(200, {"ok": True, "revoked": TOKENS.revoke(token)})

    def _exec(self):
        payload = self._body() or {}
        token = payload.get("token") or self._token()
        rec = TOKENS.get(token) if token else None
        if not rec:
            return self._json(401, {"ok": False, "error": "invalid or expired token"})

        command = payload.get("command")
        if isinstance(command, list):
            command = " ".join(shlex.quote(str(c)) for c in command)
        if not isinstance(command, str) or not command.strip():
            return self._json(400, {"ok": False, "error": "command must be a non-empty string or list"})

        ssh = shutil.which("ssh")
        if not ssh:
            return self._json(500, {"ok": False, "error": "the 'ssh' binary was not found on this host"})

        cred = rec.get("credential") or {}
        env = dict(os.environ)
        temp_key = None
        base = [
            ssh,
            "-o", "StrictHostKeyChecking=accept-new",
            "-o", "UserKnownHostsFile=" + KNOWN_HOSTS,
            "-o", "LogLevel=ERROR",
            "-o", "ConnectTimeout=15",
            "-o", "NumberOfPasswordPrompts=1",
            "-o", "RequestTTY=no",
            "-p", str(rec["port"]),
        ]
        if cred.get("password") is not None:
            # reuse the credential that /login already proved, from memory only
            env["SSH_ASKPASS"] = askpass_helper()
            env["SSH_ASKPASS_REQUIRE"] = "force"
            env["DISPLAY"] = env.get("DISPLAY", ":0")
            env["HTTPS_SSH_PW"] = cred["password"]
            base += ["-o", "BatchMode=no",
                     "-o", "PreferredAuthentications=password,keyboard-interactive"]
        elif cred.get("key"):
            key_path, is_temp = materialize_key(cred["key"])
            if is_temp:
                temp_key = key_path
            base += ["-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes",
                     "-i", key_path]
        else:
            return self._json(500, {"ok": False, "error": "session has no reusable credential"})

        cmd = base + ["%s@%s" % (rec["user"], rec["host"]), command]
        try:
            try:
                proc = subprocess.run(cmd, env=env, timeout=int(payload.get("timeout") or 60),
                                      stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            except subprocess.TimeoutExpired:
                return self._json(504, {"ok": False, "error": "command timed out"})
        finally:
            if temp_key:
                try:
                    os.unlink(temp_key)
                except OSError:
                    pass
        return self._json(200, {
            "ok": proc.returncode == 0,
            "exit_code": proc.returncode,
            "stdout": proc.stdout.decode("utf-8", "replace"),
            "stderr": proc.stderr.decode("utf-8", "replace"),
        })

    def _tunnel(self):
        ip = self._client_ip()
        agent = self.headers.get("User-Agent")

        # The token may arrive as a bearer header (our own client) or as
        # ?token=... (any standard websocket client, e.g. websocat).
        query = parse_qs(urlparse(self.path).query)
        token = self._token() or (query.get("token") or [None])[0]
        rec = TOKENS.get(token) if token else None
        target_is_fixed = False

        if rec is None:
            # Or the client authenticates inline with the SSH credentials,
            # which are checked against the real sshd just like POST /login.
            creds = self._basic_credentials()
            if creds is None:
                return self._json(401, {
                    "ok": False,
                    "error": "send Authorization: Bearer <token>, ?token=<token>, "
                             "or Authorization: Basic <base64 user:password>",
                })
            user, password = creds
            host, port = "127.0.0.1", self.server.default_ssh_port
            wait = TOKENS.throttle(ip)
            if wait > 0:
                return self._json(429, {"ok": False,
                                        "error": "too many failures, retry in %.0fs" % wait})
            ok, method, detail = verify_ssh(host, port, user, password)
            if not ok:
                TOKENS.record_failure(ip)
                record_login(False, user, host, port, method="basic", reason=detail,
                             remote=ip, client=agent)
                return self._json(401, {"ok": False, "error": detail})
            TOKENS.record_success(ip)
            record_login(True, user, host, port, method="basic", remote=ip, client=agent)
            rec = {"user": user, "host": host, "port": port}
            # with Basic auth the client cannot choose the target: no open relay
            target_is_fixed = True

        if target_is_fixed:
            target_host, target_port = rec["host"], rec["port"]
        else:
            # A token can only reach the target it was minted for.
            want_host = (self.headers.get("X-SSH-Host") or rec["host"]).strip()
            try:
                want_port = int(self.headers.get("X-SSH-Port") or rec["port"])
            except ValueError:
                return self._json(400, {"ok": False, "error": "X-SSH-Port must be a number"})
            if (want_host, want_port) != (rec["host"], rec["port"]):
                return self._json(403, {
                    "ok": False,
                    "error": "token is bound to %s@%s:%d" % (rec["user"], rec["host"], rec["port"]),
                })
            target_host, target_port = want_host, want_port

        try:
            upstream = socket.create_connection((target_host, target_port), timeout=15)
        except OSError as exc:
            return self._json(502, {"ok": False, "error": "cannot reach sshd: %s" % exc})
        # 15s applies to the connect only: create_connection leaves its timeout
        # set on the socket, and a read timeout here would look like EOF in
        # ws_bridge, tearing down every tunnel after 15s of sshd silence.
        # Idle tunnels are governed by HTTPS_SSH_IDLE instead.
        upstream.settimeout(None)
        upstream.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)

        key = self.headers.get("Sec-WebSocket-Key", "")
        if self.headers.get("Upgrade", "").lower() != "websocket" or not key:
            upstream.close()
            return self._json(426, {
                "ok": False,
                "error": "this endpoint needs a websocket upgrade "
                         "(Upgrade: websocket + Sec-WebSocket-Key)",
            })

        log("TUNNEL OPEN  %s@%s:%d (client %s)" % (rec["user"], target_host, target_port, ip))
        self.wfile.write(
            b"HTTP/1.1 101 Switching Protocols\r\n"
            b"Upgrade: websocket\r\n"
            b"Connection: Upgrade\r\n"
            b"Sec-WebSocket-Accept: " + ws_accept(key).encode() + b"\r\n\r\n"
        )
        self.wfile.flush()
        self.close_connection = True

        # rbufsize = 0 guarantees no bytes were buffered past the headers, so
        # the websocket can read straight from the connection.
        ws = WebSocket(self.connection, mask=False)
        ws_bridge(ws, upstream, IDLE_TIMEOUT)
        log("TUNNEL CLOSE %s@%s:%d" % (rec["user"], target_host, target_port))


