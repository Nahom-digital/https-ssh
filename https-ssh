def cmd_serve(args):
    ensure_state_dir()
    host = args.host or "127.0.0.1"
    port = args.port or DEFAULT_PORT
    ssh_port = args.ssh_port or DEFAULT_SSH_PORT
    secret = args.secret or os.environ.get("HTTPS_SSH_SECRET") or ""
    set_log_file(args.log)

    httpd = ThreadingHTTPServer((host, port), Gateway)
    httpd.daemon_threads = True
    httpd.gateway_secret = secret
    httpd.default_ssh_port = ssh_port

    log("https-ssh %s listening on http://%s:%d" % (VERSION, host, port))
    log("sshd is expected on port %d (used when a login request omits \"port\")" % ssh_port)
    log("login log: %s" % LOG_FILE)
    if host not in ("127.0.0.1", "localhost", "::1"):
        if not secret:
            log("WARNING: bound to %s with no gateway secret set. Anyone who can reach "
                "this port can attempt logins against your sshd." % host)
            log("         set HTTPS_SSH_SECRET=... or use --secret to require X-Gateway-Secret.")
        else:
            log("gateway secret required (send header X-Gateway-Secret)")
    log("publish it with:  cloudflared tunnel --url http://127.0.0.1:%d" % port)
    log("then from a client: https-ssh connect user@host -g https://<your-tunnel-url>")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        log("shutting down")
    finally:
        httpd.server_close()


# --------------------------------------------------------------------------- #
# client: login
# --------------------------------------------------------------------------- #
def http_post(url, payload, headers=None, timeout=60):
    data = json.dumps(payload).encode()
    req = urllib.request.Request(url, data=data, method="POST")
    req.add_header("Content-Type", "application/json")
    for k, v in (headers or {}).items():
        req.add_header(k, v)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        try:
            return exc.code, json.loads(exc.read().decode())
        except Exception:
            return exc.code, {"ok": False, "error": "HTTP %d" % exc.code}
    except Exception as exc:
        return 0, {"ok": False, "error": "cannot reach gateway: %s" % exc}


def do_login(gateway, user, host, port, password=None, key=None, secret=None, quiet=False):
    headers = {"X-Gateway-Secret": secret} if secret else {}
    body = {"host": host, "port": port, "user": user}
    if password is not None:
        body["password"] = password
    if key:
        body["key"] = key
    status, resp = http_post(gateway.rstrip("/") + "/login", body, headers)
    if status != 200 or not resp.get("ok"):
        raise SystemExit("login failed: %s" % resp.get("error", "HTTP %d" % status))
    sessions = load_sessions()
    sessions[session_key(gateway, user, host, port)] = {
        "token": resp["token"], "gateway": gateway.rstrip("/"),
        "user": user, "host": host, "port": port,
        "expires": time.time() + resp.get("expires_in", TOKEN_TTL),
        "secret": secret or "",
    }
    save_sessions(sessions)
    if not quiet:
        log("authenticated %s@%s:%d via %s" % (user, host, port, resp.get("method")))
    return resp["token"]


def stored_session(gateway, user, host, port):
    rec = load_sessions().get(session_key(gateway, user, host, port))
    if not rec or rec.get("expires", 0) < time.time() + 5:
        return None
    return rec


def cmd_login(args):
    user, host, port = split_target(args.target, args.ssh_port)
    password = args.password
    if password is None and not args.key:
        password = prompt_password(user, host)
    do_login(args.gateway, user, host, port, password, args.key, args.secret)


def cmd_logout(args):
    sessions = load_sessions()
    if args.target:
        user, host, port = split_target(args.target, args.ssh_port)
        key = session_key(args.gateway, user, host, port)
        gone = sessions.pop(key, None) is not None
    else:
        gone = bool(sessions)
        sessions = {}
    save_sessions(sessions)
    log("logged out" if gone else "nothing stored")


def cmd_status(args):
    sessions = load_sessions()
    if not sessions:
        print("no stored sessions")
        return
    for key, rec in sessions.items():
        left = int(rec.get("expires", 0) - time.time())
        state = "valid" if left > 0 else "expired"
        print("%-45s %-8s %s" % (key, state, ("in %ds" % left) if left > 0 else ""))


# --------------------------------------------------------------------------- #
# client: proxy (raw tunnel, used by ssh -o ProxyCommand)
# --------------------------------------------------------------------------- #
def open_tunnel(gateway, token, host, port, secret=None, timeout=30):
    """Open a websocket to /tunnel; returns a WebSocket speaking raw sshd bytes."""
    url = urlparse(gateway if "://" in gateway else "http://" + gateway)
    tls = url.scheme == "https"
    netloc = url.netloc or url.path
    if ":" in netloc:
        g_host, _, g_port = netloc.rpartition(":")
    else:
        g_host, g_port = netloc, ("443" if tls else "80")
    sock = socket.create_connection((g_host, int(g_port)), timeout=timeout)
    if tls:
        ctx = ssl.create_default_context()
        sock = ctx.wrap_socket(sock, server_hostname=g_host.split(":")[0])
    sock.settimeout(timeout)

    key = base64.b64encode(os.urandom(16)).decode()
    lines = [
        "GET %s/tunnel HTTP/1.1" % (url.path.rstrip("/") or ""),
        "Host: %s" % netloc,
        "Upgrade: websocket",
        "Connection: Upgrade",
        "Sec-WebSocket-Key: %s" % key,
        "Sec-WebSocket-Version: 13",
        "Authorization: Bearer %s" % token,
        "X-SSH-Host: %s" % host,
        "X-SSH-Port: %d" % port,
        "User-Agent: https-ssh/%s" % VERSION,
    ]
    if secret:
        lines.append("X-Gateway-Secret: %s" % secret)
    sock.sendall(("\r\n".join(lines) + "\r\n\r\n").encode())

    buf = b""
    while b"\r\n\r\n" not in buf:
        chunk = sock.recv(4096)
        if not chunk:
            break
        buf += chunk
    head, _, rest = buf.partition(b"\r\n\r\n")
    lines_out = head.decode("latin1").split("\r\n")
    status_line = lines_out[0]
    headers = {}
    for line in lines_out[1:]:
        if ":" in line:
            k, _, v = line.partition(":")
            headers[k.strip().lower()] = v.strip()

    if status_line.split(" ")[1:2] != ["101"]:
        detail = rest.decode("utf-8", "replace").strip()
        try:
            detail = json.loads(detail).get("error", detail)
        except Exception:
            pass
        sock.close()
        raise SystemExit("gateway refused the tunnel: %s %s" % (status_line, detail))
    if headers.get("sec-websocket-accept") != ws_accept(key):
        sock.close()
        raise SystemExit("gateway sent a bad websocket handshake (Sec-WebSocket-Accept mismatch)")

    sock.settimeout(None)
    return WebSocket(sock, mask=True, initial=rest)


def cmd_proxy(args):
    """Bridge stdin/stdout to sshd. This is what ssh calls as its ProxyCommand."""
    host, port = args.host, args.port
    user = args.user or os.environ.get("HTTPS_SSH_USER") or os.environ.get("USER", "root")
    gateway = args.gateway
    rec = stored_session(gateway, user, host, port)
    if not rec:
        raise SystemExit(
            "no valid session for %s@%s:%d on %s\nrun: https-ssh login %s@%s -g %s"
            % (user, host, port, gateway, user, host, gateway)
        )

    ws = open_tunnel(gateway, rec["token"], host, port, rec.get("secret"))
    ws_client_bridge(ws, sys.stdin.fileno(), sys.stdout.fileno(), IDLE_TIMEOUT)


# --------------------------------------------------------------------------- #
# client: connect (login + real interactive ssh)
# --------------------------------------------------------------------------- #
def self_command():
    """The command ssh should use to reach our proxy subcommand."""
    installed = shutil.which("https-ssh")
    if installed:
        return shlex.quote(installed)
    return "%s %s" % (shlex.quote(sys.executable), shlex.quote(os.path.abspath(sys.argv[0])))


def cmd_connect(args):
    user, host, port = split_target(args.target, args.ssh_port)
    gateway = args.gateway
    secret = args.secret or os.environ.get("HTTPS_SSH_SECRET") or ""

    password = args.password
    rec = stored_session(gateway, user, host, port)
    if rec is None or args.force_login:
        if password is None and not args.key:
            password = prompt_password(user, host)
        do_login(gateway, user, host, port, password, args.key, secret or None)
        rec = stored_session(gateway, user, host, port)

    if args.key:
        rec["secret"] = secret
        # make the proxy subprocess see the same session
        sessions = load_sessions()
        sessions[session_key(gateway, user, host, port)] = rec
        save_sessions(sessions)

    proxy_cmd = "%s proxy %s %d -u %s -g %s" % (
        self_command(), shlex.quote(host), port, shlex.quote(user), shlex.quote(gateway),
    )
    ssh = shutil.which("ssh") or "ssh"
    cmd = [ssh, "-o", "ProxyCommand=" + proxy_cmd, "-p", str(port),
           "-o", "StrictHostKeyChecking=accept-new"]

    # Reuse the password we already verified so ssh does not ask again.
    # The secret is handed over through an environment variable and a throwaway
    # askpass helper - it is never written to disk.
    env = dict(os.environ)
    tmp = None
    if password is not None and not args.key:
        fd, helper = tempfile.mkstemp(prefix="https-ssh-askpass-")
        os.write(fd, b"#!/bin/sh\nprintf '%s\\n' \"$HTTPS_SSH_PW\"\n")
        os.close(fd)
        os.chmod(helper, 0o700)
        tmp = helper
        env["SSH_ASKPASS"] = helper
        env["SSH_ASKPASS_REQUIRE"] = "force"
        env["DISPLAY"] = env.get("DISPLAY", ":0")
        env["HTTPS_SSH_PW"] = password
        cmd += ["-o", "PreferredAuthentications=password,keyboard-interactive",
                "-o", "NumberOfPasswordPrompts=1"]
    elif args.key:
        cmd += ["-i", os.path.expanduser(args.key), "-o", "IdentitiesOnly=yes"]

    cmd += ["%s@%s" % (user, host)]
    cmd += args.ssh_args   # remote command / extra ssh args, after the host like ssh(1)

    if sys.stdin.isatty() and sys.stdout.isatty():
        cmd.insert(1, "-t")   # interactive: keep a real tty on the far side

    try:
        proc = subprocess.run(cmd, env=env)
    finally:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    sys.exit(proc.returncode)


def cmd_exec(args):
    user, host, port = split_target(args.target, args.ssh_port)
    gateway = args.gateway
    secret = args.secret or os.environ.get("HTTPS_SSH_SECRET") or ""
    rec = stored_session(gateway, user, host, port)
    if rec is None or args.force_login:
        password = args.password
        if password is None and not args.key:
            password = prompt_password(user, host)
        do_login(gateway, user, host, port, password, args.key, secret or None)
        rec = stored_session(gateway, user, host, port)
    command = " ".join(args.command)
    if not command.strip():
        raise SystemExit("usage: https-ssh exec [options] USER@HOST -- COMMAND")
    status, resp = http_post(
        gateway.rstrip("/") + "/exec",
        {"token": rec["token"], "command": command},
        {"X-Gateway-Secret": secret} if secret else {},
    )
    if resp.get("stdout"):
        sys.stdout.write(resp["stdout"])
    if resp.get("stderr"):
        sys.stderr.write(resp["stderr"])
    if status != 200:
        sys.stderr.write("error: %s\n" % resp.get("error"))
        sys.exit(1)
    sys.exit(resp.get("exit_code", 1))


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #
def build_parser():
    p = argparse.ArgumentParser(
        prog="https-ssh",
        description="Run SSH over HTTP/HTTPS (for Cloudflare Tunnel and friends).",
        epilog="With no subcommand, the options alone start the service: "
               "https-ssh --port 8899 --ssh 22",
    )
    p.add_argument("--version", action="version", version="https-ssh " + VERSION)

    def server_opts(sp, suppress=False):
        # On the subcommand we use SUPPRESS so that a value given at the top
        # level (https-ssh --port X serve) is not overwritten by the default.
        d = argparse.SUPPRESS if suppress else None
        sp.add_argument("--host", default=d,
                        help="address the service binds to (default 127.0.0.1)")
        sp.add_argument("--port", type=int, default=d,
                        help="port the service listens on (default %d)" % DEFAULT_PORT)
        sp.add_argument("--ssh", dest="ssh_port", type=int, default=d,
                        help="port sshd is running on (default %d)" % DEFAULT_SSH_PORT)
        sp.add_argument("--secret", default=d,
                        help="require header X-Gateway-Secret on /login")
        sp.add_argument("--log", default=d,
                        help="login log file (default %s)" % LOG_FILE)
        sp.add_argument("--service", action="store_true",
                        default=argparse.SUPPRESS if suppress else False,
                        help="install as a systemd service and start it, then exit")
        sp.add_argument("--no-service", action="store_true",
                        default=argparse.SUPPRESS if suppress else False,
                        help="do not offer to install a systemd service")

    # top level, so `https-ssh --port 8899 --ssh 22` works on its own
    server_opts(p)
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("serve", help="run the HTTP->SSH gateway (the service)")
    server_opts(s, suppress=True)
    s.set_defaults(func=cmd_serve)

    def client_opts(sp):
        sp.add_argument("target", help="USER@HOST or USER@HOST:PORT")
        sp.add_argument("-g", "--gateway", default=DEFAULT_GATEWAY, help="gateway URL")
        # SUPPRESS so a top-level --ssh / --secret is inherited
        sp.add_argument("--ssh-port", "--ssh", dest="ssh_port", type=int,
                        default=argparse.SUPPRESS,
                        help="target sshd port (default %d)" % DEFAULT_SSH_PORT)
        sp.add_argument("-p", "--password", default=None, help="SSH password (otherwise prompt)")
        sp.add_argument("-i", "--key", default=None, help="SSH private key instead of a password")
        sp.add_argument("--secret", default=argparse.SUPPRESS,
                        help="X-Gateway-Secret, if the gateway needs one")
        sp.add_argument("--force-login", action="store_true", help="re-authenticate even if a token exists")

    l = sub.add_parser("login", help="POST credentials to /login and store the token")
    client_opts(l)
    l.set_defaults(func=cmd_login)

    c = sub.add_parser("connect", help="login then open a real interactive ssh session")
    client_opts(c)
    c.set_defaults(func=cmd_connect, ssh_args=[])

    x = sub.add_parser("exec", help="run one command through the gateway (HTTPS only)")
    client_opts(x)
    x.set_defaults(func=cmd_exec, command=[])

    pr = sub.add_parser("proxy", help="websocket tunnel client, used as ssh ProxyCommand")
    pr.add_argument("host")
    pr.add_argument("port", type=int)
    pr.add_argument("-u", "--user", default=None)
    pr.add_argument("-g", "--gateway", default=DEFAULT_GATEWAY)
    pr.set_defaults(func=cmd_proxy)

    st = sub.add_parser("status", help="list stored session tokens")
    st.set_defaults(func=cmd_status)

    lo = sub.add_parser("logout", help="drop stored session tokens")
    lo.add_argument("target", nargs="?", help="USER@HOST to drop (all if omitted)")
    lo.add_argument("-g", "--gateway", default=DEFAULT_GATEWAY)
    lo.add_argument("--ssh-port", "--ssh", dest="ssh_port", type=int,
                    default=argparse.SUPPRESS)
    lo.set_defaults(func=cmd_logout)
    return p


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)

    # For connect/exec, everything after the first standalone "--" is passed
    # through verbatim (the remote command / extra ssh args), and options are
    # still parsed normally even when they come before the subcommand.
    before, tail = argv, []
    had_dashdash = "--" in argv
    if had_dashdash:
        cut = argv.index("--")
        before, tail = argv[:cut], argv[cut + 1:]

    parser = build_parser()
    args = parser.parse_args(before)

    if args.cmd not in ("connect", "exec"):
        tail = []
        if had_dashdash:
            # not a passthrough command: let argparse treat "--" its usual way
            args = parser.parse_args(argv)

    # remember which server options were given on the command line, so that
    # --service keeps the other settings from the existing /etc/default file
    args._explicit = {
        key for opt, key in (("--host", "host"), ("--port", "port"),
                             ("--ssh", "ssh_port"), ("--secret", "secret"),
                             ("--log", "log"))
        if any(a == opt or a.startswith(opt + "=") for a in argv)
    }

    # `https-ssh --port 9000 --ssh 2222` (no subcommand) means "run the service"
    if not args.cmd:
        if (any(v is not None for v in (args.port, args.host, args.ssh_port, args.secret, args.log))
                or getattr(args, "service", False)
                or getattr(args, "no_service", False)):
            args.cmd = "serve"
            args.func = cmd_serve
        else:
            parser.print_help()
            return 0

    args.host = getattr(args, "host", None) or os.environ.get("HTTPS_SSH_HOST") or "127.0.0.1"
    args.port = getattr(args, "port", None) or env_int("HTTPS_SSH_PORT", DEFAULT_PORT)
    args.ssh_port = getattr(args, "ssh_port", None) or env_int("HTTPS_SSH_SSH_PORT", DEFAULT_SSH_PORT)
    args.secret = getattr(args, "secret", None)
    args.log = getattr(args, "log", None)

    # First run of the gateway: ask whether it should become a service.
    if args.cmd == "serve":
        rc = offer_service(args)
        if rc is not None:
            return rc

    if args.cmd == "connect":
        args.ssh_args = tail
    elif args.cmd == "exec":
        args.command = tail

    ensure_state_dir()
    return args.func(args) or 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
