# login log (unset = log.json next to the application)
%s

# tuning
HTTPS_SSH_TTL=%d
HTTPS_SSH_IDLE=%d
HTTPS_SSH_LOG_MAX=%d
""" % (cfg["host"], cfg["port"], cfg["ssh_port"], cfg["secret"], log_line,
       cfg["ttl"], cfg["idle"], cfg["log_max"])


def _priv_prefix():
    """Command prefix for system paths: [] as root, ['sudo'], or None."""
    if os.geteuid() == 0:
        return []
    if shutil.which("sudo"):
        return ["sudo"]
    return None


def _write_system_file(path, text, mode):
    prefix = _priv_prefix()
    if prefix is None:
        return False
    try:
        if prefix:
            subprocess.run(prefix + ["mkdir", "-p", os.path.dirname(path)],
                           check=True)
            subprocess.run(prefix + ["tee", path], input=text, text=True,
                           stdout=subprocess.DEVNULL, check=True)
            subprocess.run(prefix + ["chmod", "%o" % mode, path], check=True)
        else:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as f:
                f.write(text)
            os.chmod(path, mode)
        return True
    except (OSError, subprocess.CalledProcessError):
        return False


def install_service(args):
    """Write the systemd units + /etc/default file and start the service."""
    exe = shutil.which("https-ssh")
    if not exe:
        launcher = os.path.join(APP_DIR, "https-ssh.sh")
        exe = launcher if os.path.exists(launcher) else os.path.abspath(__file__)
    path_unit, restart_unit = _restart_units_text()
    cfg = _effective_config(args)
    files = [
        (os.path.join(SYSTEMD_DIR, "https-ssh.service"),
         _service_unit_text(exe, cfg["port"], cfg["ssh_port"]), 0o644),
        (os.path.join(SYSTEMD_DIR, "https-ssh-restart.path"), path_unit, 0o644),
        (os.path.join(SYSTEMD_DIR, "https-ssh-restart.service"), restart_unit, 0o644),
        (DEFAULTS_FILE, _defaults_text(cfg), 0o600 if cfg["secret"] else 0o644),
    ]
    for path, text, mode in files:
        if not _write_system_file(path, text, mode):
            log("could not write %s" % path)
            log("install the service by hand as root: sudo https-ssh --service")
            return 1

    if SYSTEMD_DIR != "/etc/systemd/system":
        return 0   # redirected to a custom prefix: files only, no systemctl

    prefix = _priv_prefix() or []
    try:
        subprocess.run(prefix + ["systemctl", "daemon-reload"],
                       stdout=subprocess.DEVNULL, check=True)
        subprocess.run(prefix + ["systemctl", "enable", "--now",
                                 "https-ssh.service", "https-ssh-restart.path"],
                       stdout=subprocess.DEVNULL, check=True)
    except (OSError, subprocess.CalledProcessError) as exc:
        log("units written, but systemctl failed (%s)" % exc)
        log("start it by hand: systemctl enable --now https-ssh.service https-ssh-restart.path")
        return 1

    for _ in range(10):
        time.sleep(0.3)
        rc = subprocess.run(prefix + ["systemctl", "is-active", "--quiet",
                                      "https-ssh.service"]).returncode
        if rc == 0:
            log("https-ssh is running as a service: port %d -> sshd %d, starts on boot"
                % (cfg["port"], cfg["ssh_port"]))
            log("manage it with: systemctl status https-ssh | journalctl -u https-ssh -f")
            return 0
    log("the service was installed but is not active yet; check: systemctl status https-ssh")
    return 1


def _write_asked(what):
    ensure_state_dir()
    try:
        with open(SERVICE_ASKED, "w") as f:
            f.write(what + "\n")
    except OSError:
        pass


def offer_service(args):
    """First-run offer. Returns an exit code to stop, or None to keep serving."""
    if getattr(args, "service", False):
        return install_service(args)
    if getattr(args, "no_service", False):
        _write_asked("foreground")
        return None
    if os.path.exists(os.path.join(SYSTEMD_DIR, "https-ssh.service")):
        return None
    if os.path.exists(SERVICE_ASKED):
        return None
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return None

    log("first run on this machine")
    while True:
        sys.stderr.write("Do you want https-ssh to run as a systemd service? (y/n): ")
        sys.stderr.flush()
        answer = sys.stdin.readline()
        answer = (answer or "n").strip().lower()
        if answer in ("y", "yes"):
            rc = install_service(args)
            if rc == 0:
                _write_asked("service")
                return rc
            log("service setup failed; starting in the foreground instead")
            return None
        if answer in ("n", "no"):
            _write_asked("foreground")
            log("ok, running in the foreground "
                "(install the service later with: https-ssh --service)")
            return None
        sys.stderr.write("please answer y or n\n")


